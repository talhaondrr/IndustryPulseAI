@model Page<SensorFeed>
@{ ViewData["Title"] = "Sensor Monitor"; }
<header class="page-heading"><div><span class="eyebrow">OPERATIONS</span><h1>Sensor Monitor</h1><p>Recent events stored in PostgreSQL, ordered by UTC event time.</p></div><span class="pill outline">Refreshes every 15 s</span></header>
<p class="notice" id="feed-status" role="status">@(Model.Error ?? (Model.Data?.TableAvailable == true ? "Showing the latest stored events." : "The streaming table is unavailable."))</p>
<div id="sensor-feed" data-initial="@System.Text.Json.JsonSerializer.Serialize(Model.Data, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.SnakeCaseLower })">
    <div class="sensor-grid">
    @foreach (var chart in new[] { ("temp","Temperature","K"),("torque","Torque","N·m"),("speed","Rotational speed","rpm"),("wear","Tool wear","min") })
    {
        <section class="panel"><h2>@chart.Item2 <small class="unit">@chart.Item3</small></h2><div class="chart-frame"><canvas id="@chart.Item1" role="img" aria-label="@chart.Item2 over recent events"></canvas></div></section>
    }
    </div>
    <section class="panel"><h2>Recent sensor events</h2><p>Up to 30 measurements from the stream table</p>
        <div class="table-wrap"><table><thead><tr><th>Event time (UTC)</th><th>Product</th><th>Air (K)</th><th>Process (K)</th><th>Speed (rpm)</th><th>Torque (N·m)</th><th>Wear (min)</th></tr></thead><tbody id="sensor-rows">
        @foreach (var row in Model.Data?.Readings ?? [])
        {
            <tr><td>@row.EventTime.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@row.ProductType</td><td>@row.AirTemperature</td><td>@row.ProcessTemperature</td><td>@row.RotationalSpeed</td><td>@row.Torque</td><td>@row.ToolWear</td></tr>
        }
        </tbody></table></div>
    </section>
</div>
